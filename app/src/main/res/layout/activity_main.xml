<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- ESP snapshot preview -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <WebView
                android:id="@+id/espStreamView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layerType="software" />

            <ImageView
                android:id="@+id/espImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Status / OCR / AI text -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="#181818"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnVoiceCommand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎤 Speak Command"
            android:textSize="18sp"
            android:backgroundTint="#FF5722"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp" />

        <!-- Main capture button -->
        <Button
            android:id="@+id/btnEspCapture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capture from Glasses"
            android:textSize="18sp"
            android:backgroundTint="#007BFF"
            android:textColor="#FFFFFF"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnRestartStream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Restart Stream"
            android:textSize="18sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <!-- NEW BUTTON: Find Nearby Places -->

        <Button
            android:id="@+id/btnFindPlaces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#28A745"
            android:paddingLeft="28dp"
            android:paddingTop="12dp"
            android:paddingRight="28dp"
            android:paddingBottom="12dp"
            android:text="Find Nearby Places"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnRepeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Repeat TTS"
            android:textSize="18sp"
            android:backgroundTint="#607D8B"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

    </LinearLayout>
</ScrollView>
